---
import { href } from '../lib/paths';
import { REDIRECTS } from '../lib/site';

// The floor plan was at /floor-plan/ until it became the home page (#28). GitHub Pages can't send
// a redirect, so this page refreshes to its REDIRECTS target at once. It carries noindex and no
// canonical, like the 404 page: the old URL was never indexed, and the two would conflict.
const to = href(REDIRECTS['floor-plan/']);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="refresh" content={`0;url=${to}`} />
		<meta name="robots" content="noindex" />
		<title>Oil on Cotton</title>
	</head>
	<body>
		<p>The floor plan is now the <a href={to}>home page</a>.</p>
		<p>
			An independent, non-commercial index. It is not affiliated with or endorsed by any museum. Names identify the
			shops; trademarks belong to their owners.
		</p>
	</body>
</html>
