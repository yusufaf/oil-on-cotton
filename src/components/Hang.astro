---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import type { CatalogItem } from '../lib/catalog';
import type { Hang } from '../lib/curation';
import { priceText } from '../lib/room';

interface Props {
	shop: string;
	hangs: Hang<CatalogItem>[];
	now: Date;
}

const { shop, hangs, now } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/hang/*', { eager: true });
const imageOf = (file: string) => {
	const image = files[`../assets/hang/${file}`]?.default;
	if (!image) throw new Error(`src/assets/hang/${file} is missing (data/curation.yaml)`);
	return image;
};

// Every file must be 200 KB or less (DESIGN.md). A busy painting fits at 1280px only as AVIF,
// so the WebP fallback, for browsers without AVIF, stops at 960px.
const sizes = '(max-width: 720px) calc(100vw - 40px), 640px';
const pictures = await Promise.all(
	hangs.map(async ({ work }) => {
		const src = imageOf(work.image.file);
		const [avif, webp] = await Promise.all([
			getImage({ src, format: 'avif', quality: 40, width: 1280, widths: [640, 960, 1280] }),
			getImage({ src, format: 'webp', quality: 60, width: 960, widths: [640, 960] }),
		]);
		return { avif, webp };
	}),
);
---

<section class="hang" aria-label="Hung works">
	{
		hangs.map(({ work, pieces }, i) => (
			<figure>
				<picture>
					<source type="image/avif" srcset={pictures[i].avif.srcSet.attribute} sizes={sizes} />
					<img
						src={pictures[i].webp.src}
						srcset={pictures[i].webp.srcSet.attribute}
						sizes={sizes}
						width={pictures[i].webp.attributes.width}
						height={pictures[i].webp.attributes.height}
						alt={work.image.alt}
						loading="eager"
						decoding="async"
					/>
				</picture>
				<figcaption>
					<p>
						<span class="artist">{work.name}</span>
						<br />
						{work.artistLine}
					</p>
					<p class="title">
						<i>{work.title}</i>, {work.date}
					</p>
					<p>
						{work.collection}, {work.accession}. Image in the public domain, courtesy of {work.image.credit}.
					</p>
					<div class="made">
						<p class="heading">Made after this {work.kind}</p>
						<ul>
							{pieces.map(({ label, item }) => (
								<li>
									<a
										href={item.url}
										target="_blank"
										rel="nofollow noopener"
										data-umami-event="Outbound"
										data-umami-event-museum={item.museum}
										data-umami-event-item={item.id}
									>
										{label}
									</a>
									<span class="price">{priceText(item, now).text}</span>
								</li>
							))}
						</ul>
					</div>
					<p class="credit">Sold by the {shop}</p>
				</figcaption>
			</figure>
		))
	}
</section>

<style>
	.hang {
		display: flex;
		flex-direction: column;
		gap: 104px;
		padding: 40px 0 128px;
	}

	figure {
		margin: 0;
		display: grid;
		grid-template-columns: minmax(0, 640px) minmax(0, 256px);
		gap: 104px;
		align-items: center;
		justify-content: center;
	}

	figure :global(img) {
		display: block;
		width: 100%;
		height: auto;
		box-shadow:
			0 1px 0 rgba(0, 0, 0, 0.25),
			0 18px 28px -18px rgba(0, 0, 0, 0.55);
	}

	figcaption {
		background: var(--label);
		color: var(--ink);
		padding: 18px 20px 20px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		font-size: 14px;
		line-height: 1.45;
	}

	p {
		margin: 0;
	}

	.artist {
		font-weight: 600;
		font-size: 16px;
	}

	.title {
		font-family: var(--serif);
		font-size: 19px;
		line-height: 1.3;
	}

	.made {
		border-top: 1px solid var(--rule);
		padding-top: 14px;
	}

	.heading {
		font-weight: 600;
		margin-bottom: 10px;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
	}

	a {
		text-decoration: none;
	}

	a:hover,
	a:focus-visible {
		text-decoration: underline;
	}

	.price {
		flex: none;
		font-variant-numeric: tabular-nums;
	}

	.credit {
		font-size: 13px;
	}

	@media (max-width: 900px) {
		figure {
			grid-template-columns: minmax(0, 640px);
			gap: 32px;
			justify-content: start;
		}

		figcaption {
			width: 256px;
			max-width: 100%;
			box-sizing: border-box;
		}
	}

	@media (max-width: 720px) {
		.hang {
			padding: 8px 0 72px;
			gap: 72px;
		}
	}
</style>
